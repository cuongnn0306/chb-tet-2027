# Local secrets for `npx supabase functions serve` (copy to supabase/functions/.env; never commit it).
# In staging/production set the same names with: npx supabase secrets set NAME=value
# SePay authentication modes are alternatives; configure the one(s) SePay uses. With none set,
# every request is rejected (fail closed).
# API-key mode: "Authorization: Apikey <key>"
SEPAY_WEBHOOK_API_KEY=change-me-local-only
# HMAC mode: X-SePay-Timestamp (Unix seconds, 5-minute window) + X-SePay-Signature: sha256=<hex>
# over "{timestamp}.{raw body}". Use SePay's Secret Key (never commit a real one).
# SEPAY_WEBHOOK_HMAC_SECRET=
