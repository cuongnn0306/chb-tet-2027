# Copy to .env.local for local development. NEVER commit real values.
# Values for local come from `npx supabase start` (or `npx supabase status`).

# Environment name: local | staging | production
VITE_APP_ENV=local

# Browser-safe values only (public URL + anon/publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-side secrets: NEVER use the VITE_ prefix ---
# Set these in Vercel server env / `supabase secrets set`, not in browser code.
# SEPAY_WEBHOOK_SECRET=
# SUPABASE_SERVICE_ROLE_KEY=
